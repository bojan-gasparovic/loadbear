{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoadBear",
  "version": "0.1.0",
  "identifier": "com.zeroemdashes.loadbear",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "LoadBear",
        "width": 900,
        "height": 588,
        "resizable": false,
        "visible": true,
        "decorations": false,
        "maximizable": false,
        "minimizable": true,
        "fullscreen": false,
        "alwaysOnTop": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Bojan Gasparovic",
    "copyright": "Copyright 2026 Bojan Gasparovic. Apache-2.0.",
    "category": "DeveloperTool",
    "shortDescription": "Shows what is overloading your machine, not merely that it is busy.",
    "longDescription": "LoadBear is a resident monitor that measures resource stall rather than utilization, names the process or container responsible, and judges the hardware against limits its vendor published rather than against invented thresholds.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/loadbear-service"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
