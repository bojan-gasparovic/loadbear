# Rust
target/
**/*.rs.bk
*.pdb

# Tauri
src-tauri/target/
src-tauri/gen/

# Frontend
node_modules/
dist/
.vite/
*.tsbuildinfo

# The application has no bundler, so its `dist` is hand-written source rather
# than build output. The rule above was swallowing the entire interface, which
# meant a fresh clone could not produce a working window.
!crates/loadbear-app/dist/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp

# Local scratch
.temp/
scratch/

# Tauri regenerates these on every build
crates/loadbear-app/gen/

# The helper, staged for the bundler by build-installer.ps1. A build artifact
# that happens to live under source, so it is ignored like any other.
crates/loadbear-app/binaries/
